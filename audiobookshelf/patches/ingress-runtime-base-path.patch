diff --git a/client/public-path.js b/client/public-path.js
new file mode 100644
index 0000000..0c1f1f5
--- /dev/null
+++ b/client/public-path.js
@@ -0,0 +1,17 @@
+// Home Assistant Ingress serves Audiobookshelf from a path that is only settled
+// per request, and NGINX writes that path into the page for the client to read
+// back out of the Nuxt runtime configuration.
+//
+// Nuxt makes this same assignment in its own client entry, but does it in that
+// module's body, which runs only after everything the entry imports has already
+// been evaluated. Every font and image webpack turns into "publicPath + name"
+// resolves its address at exactly that moment, so by then all of them have been
+// handed the path this was built with and go asking Home Assistant's site root
+// for it. Running ahead of that entry is early enough for all of them.
+if (typeof window !== 'undefined') {
+  const app = ((window.__NUXT__ || {}).config || {})._app
+  if (app && app.assetsPath) {
+    // eslint-disable-next-line no-undef
+    __webpack_public_path__ = (app.cdnURL || '') + app.assetsPath
+  }
+}
