#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: Audiobookshelf
# Configures NGINX for use with Audiobookshelf
# ==============================================================================

# Generate Ingress configuration
bashio::var.json \
    interface "$(bashio::app.ip_address)" \
    port "^$(bashio::app.ingress_port)" \
    | tempio \
        -template /etc/nginx/templates/ingress.gtpl \
        -out /etc/nginx/servers/ingress.conf

# Generate direct access configuration, if enabled. The mobile apps need an
# address of their own: an Ingress path is neither stable nor reachable from
# outside Home Assistant, so anything that is not the web interface talks to
# this app over the published port instead.
#
# What is asked for here is only whether a port was published at all. NGINX
# listens on the container's own 13378 either way, which is the far side of
# whatever mapping the "Network" section sets up, so moving the published port
# to another number on the host keeps working.
if bashio::var.has_value "$(bashio::app.port 13378)"; then
    bashio::config.require.ssl

    bashio::var.json \
        certfile "$(bashio::config 'certfile')" \
        keyfile "$(bashio::config 'keyfile')" \
        port "^13378" \
        ssl "^$(bashio::config 'ssl')" \
        | tempio \
            -template /etc/nginx/templates/direct.gtpl \
            -out /etc/nginx/servers/direct.conf
fi
